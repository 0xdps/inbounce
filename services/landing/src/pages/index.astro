  <script define:vars={{ WAITLIST_URL }}>
    // ── Scroll reveal ─────────────────────────────
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08 });

    document.querySelectorAll('.reveal, #mockup').forEach(el => io.observe(el));

    // ── Waitlist submission ───────────────────────
    async function submitWaitlist(formEl, successEl) {
      const emailInput = formEl.querySelector('input[type="email"]');
      const btn = formEl.querySelector('button[type="submit"]');
      const email = emailInput.value.trim();
      if (!email) return;

      const origText = btn.textContent;
      btn.textContent = 'Joining…';
      btn.classList.add('loading');

      try {
        const res = await fetch(WAITLIST_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        if (!res.ok) throw new Error('server error');

        formEl.classList.add('hidden');
        successEl.classList.add('visible');
      } catch {
        btn.textContent = origText;
        btn.classList.remove('loading');
        emailInput.style.outline = '1.5px solid #f43f5e';
        setTimeout(() => { emailInput.style.outline = ''; }, 2000);
      }
    }

    ['hero-form', 'cta-form'].forEach((id, i) => {
      const successId = i === 0 ? 'hero-success' : 'cta-success';
      document.getElementById(id)?.addEventListener('submit', e => {
        e.preventDefault();
        submitWaitlist(
          document.getElementById(id),
          document.getElementById(successId),
        );
      });
    });

    // ── Copy code snippet ─────────────────────────
    document.querySelectorAll('.copy-btn[data-copy-target]').forEach(btn => {
      btn.addEventListener('click', () => {
        const pre = document.getElementById(btn.dataset.copyTarget);
        if (!pre) return;
        navigator.clipboard.writeText(pre.innerText).then(() => {
          btn.textContent = 'copied!';
          setTimeout(() => { btn.textContent = 'copy'; }, 2000);
        });
      });
    });
  </script>

