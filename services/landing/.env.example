# ──────────────────────────────────────────────────────────
# Inbounce Landing — Environment Variables
# Copy to .env (for local dev) — Astro reads PUBLIC_* at build time
# ──────────────────────────────────────────────────────────

# URL the waitlist form posts to.
# Dev:  leave blank (Astro dev server doesn't proxy — run backend separately on port 3000)
# Prod: must point to api.inbounce.app because Vercel and Railway are separate origins
PUBLIC_WAITLIST_URL=https://api.inbounce.app/api/waitlist
