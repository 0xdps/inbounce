# Required
ADMIN_KEY=your_secure_admin_key_here
SESSION_SECRET=your_session_secret_here_at_least_32_chars

# Mesahub connection — two modes:
#   External: mh://token@hostname:port/db-name
#   Embedded: mh://local/db-name  (bundled mesahub-server starts inside the container)
MESAHUB_URL=mh://local/inbounce

# When using embedded mode (mh://local/…), set these so the bundled server
# uses a fixed token instead of a random one-time value:
# MESAHUB_ADMIN_TOKEN=your_secure_admin_token_here

# Optional
PORT=8078
LOG_LEVEL=info
NODE_ENV=development
CADDY_INTERNAL_PORT=8080
